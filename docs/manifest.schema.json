{"$id":"https://cumulativewebinc.github.io/cwi-onboarding-pack/manifest.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Starter manifest for an agent entering the CWI world (cwi.onboarding-manifest/1.0). Pointers only — must never carry secrets, keys, or tokens.","properties":{"agent_handle":{"minLength":1,"type":"string"},"agent_name":{"minLength":1,"type":"string"},"completed_steps":{"minimum":0,"type":"integer"},"issued_at":{"format":"date-time","type":"string"},"manifest_id":{"pattern":"^obm_[0-9A-Z]{16,}$","type":"string"},"notes":{"type":"string"},"receipt_hooks":{"items":{"format":"uri","pattern":"^https://","type":"string"},"type":"array"},"schema":{"const":"cwi.onboarding-manifest/1.0"},"steps":{"items":{"properties":{"action":{"minLength":1,"type":"string"},"id":{"enum":["identity-card","skill-scan","attitude-profile","read-catalog","trust-claim"],"type":"string"},"order":{"minimum":1,"type":"integer"},"status":{"enum":["pending","done"],"type":"string"},"title":{"minLength":1,"type":"string"},"url":{"format":"uri","pattern":"^https://","type":"string"}},"required":["id","title","url","action","status"],"type":"object"},"minItems":1,"type":"array"},"total_steps":{"minimum":1,"type":"integer"},"venue":{"minLength":1,"type":"string"}},"required":["schema","manifest_id","agent_name","agent_handle","venue","issued_at","steps"],"title":"CWI Onboarding Manifest","type":"object"}